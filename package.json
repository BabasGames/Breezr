{
  "name": "breezr",
  "productName": "Breezr",
  "version": "2.3.0-beta.1",
  "description": "Deezer desktop client, vanilla+: the real Deezer player with Discord Rich Presence and custom colors",
  "desktopName": "breezr.desktop",
  "main": "./build/src/main/index.js",
  "scripts": {
    "start": "electron ./build/src/main/index.js",
    "run": "tsc && bun run build:modal && bun run copy-assets && bun run start",
    "build": "tsc && bun run build:modal && bun run copy-assets && bun scripts/build.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint",
    "copy-assets": "cpy --flat ./src/img/* ./build/src/img/ && cpy --flat ./src/offline.html ./build/src/",
    "test": "bun test",
    "build:modal": "bun build src/renderer/settings-modal/index.ts --target=browser --format=iife --outfile=build/src/renderer/settings-modal.bundle.js",
    "build:server": "bun build server/src/main.ts --target=node --format=cjs --outfile=server/dist/server.js",
    "build:web": "bun scripts/build-web.ts"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "chalk": "6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "cpy-cli": "^7.0.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "png-to-ico": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "repository": "https://github.com/BabasGames/Breezr.git",
  "author": {
    "name": "BabasGames"
  },
  "contributors": [
    {
      "name": "Tenshii",
      "email": "tenshii@miwa.lol"
    }
  ],
  "license": "MIT"
}
