# Maintainer: BabasGames <96499176+BabasGames@users.noreply.github.com>
# Generated by .github/workflows/aur.yml from packaging/aur/PKGBUILD.in on each release: edit the template.
pkgname=breezr-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='The Deezer web player, vanilla+: themes, Discord status, live lyrics link'
arch=('x86_64' 'aarch64')
url='https://github.com/BabasGames/Breezr'
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libsecret' 'libnotify' 'xdg-utils')
provides=('breezr')
conflicts=('breezr')
options=('!strip' '!debug')
source_x86_64=("Breezr-$pkgver-amd64.deb::$url/releases/download/$pkgver/Breezr-linux-amd64.deb")
source_aarch64=("Breezr-$pkgver-arm64.deb::$url/releases/download/$pkgver/Breezr-linux-arm64.deb")
sha256sums_x86_64=('@SHA256_AMD64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  chmod -R u=rwX,go=rX "$pkgdir/opt/Breezr"
  # Chromium's sandbox helper, when the build ships one, must be setuid root.
  if [ -f "$pkgdir/opt/Breezr/chrome-sandbox" ]; then chmod 4755 "$pkgdir/opt/Breezr/chrome-sandbox"; fi

  # pacman updates Breezr: the app must not offer its own downloads.
  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/Breezr/breezr --disable-updates "$@"\n' > "$pkgdir/usr/bin/breezr"
  chmod 755 "$pkgdir/usr/bin/breezr"
  sed -i 's|^Exec=[^ ]*|Exec=/usr/bin/breezr|' "$pkgdir"/usr/share/applications/*.desktop

  install -Dm644 "$pkgdir/opt/Breezr/LICENSE.electron.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
}
